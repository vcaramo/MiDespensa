{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "midespensa-local",
  "main": "./worker/dev.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DESPENSA_STATE", "class_name": "DespensaState" }]
  },
  "exports": {
    "DespensaState": { "type": "durable-object", "storage": "sqlite" }
  }
}
